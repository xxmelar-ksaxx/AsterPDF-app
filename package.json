{
  "name": "asterpdf-desktop",
  "version": "0.4.0",
  "private": true,
  "description": "Offline PDF reading and commenting for Windows and macOS",
  "author": "AsterPDF Contributors",
  "license": "MIT",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "desktop": "electron .",
    "test": "node --import tsx --test tests/*.test.ts",
    "smoke": "node scripts/smoke-electron.cjs",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "build:win": "npm run build && electron-builder --win nsis --x64 --publish never",
    "build:mac": "npm run build && electron-builder --mac dmg zip --arm64 --publish never",
    "checksum:win": "node scripts/write-checksums.cjs win",
    "checksum:mac": "node scripts/write-checksums.cjs mac"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.4.299",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "playwright": "^1.63.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "vite": "^6.4.0"
  },
  "build": {
    "appId": "org.asterpdf.desktop",
    "productName": "AsterPDF",
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "assets/icon.png",
      "LICENSE",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.ico",
      "artifactName": "AsterPDF-${version}-Windows-${arch}-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "assets/icon.png",
      "category": "public.app-category.productivity",
      "hardenedRuntime": true,
      "entitlements": "assets/entitlements.mac.plist",
      "artifactName": "AsterPDF-${version}-macOS-${arch}.${ext}"
    },
    "dmg": {
      "writeUpdateInfo": false
    }
  }
}
